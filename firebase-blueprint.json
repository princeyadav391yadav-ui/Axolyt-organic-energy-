{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing basic account and membership tier data",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User account email",
          "maxLength": 150
        },
        "memberTier": {
          "type": "string",
          "description": "Botanical society loyalty membership tier",
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "description": "Access control role (e.g. admin or member)",
          "enum": ["admin", "member"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of latest update"
        }
      },
      "required": ["name", "email", "memberTier"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with cold-chain tracking details and invoice data",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "id": {
          "type": "string",
          "description": "Human-readable order tracking ID (e.g. AXO-948120)",
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "description": "Order placement date string",
          "maxLength": 50
        },
        "items": {
          "type": "string",
          "description": "Summary of purchased flavors and pack options",
          "maxLength": 500
        },
        "total": {
          "type": "number",
          "description": "Total purchase amount in USD"
        },
        "status": {
          "type": "string",
          "description": "Shipping status lifecycle",
          "enum": ["Confirmed", "Processing", "In Transit", "Out for Delivery", "Delivered"]
        },
        "carrier": {
          "type": "string",
          "description": "Cold-chain or priority eco carrier name",
          "maxLength": 100
        },
        "trackingNumber": {
          "type": "string",
          "description": "Carrier tracking number",
          "maxLength": 60
        },
        "estimatedDelivery": {
          "type": "string",
          "description": "Human-readable estimated delivery time",
          "maxLength": 80
        },
        "currentStepIndex": {
          "type": "number",
          "description": "Current progress index in the delivery pipeline (0 to 4)"
        },
        "customerName": {
          "type": "string",
          "description": "Customer display name",
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "description": "Customer contact email",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when order was submitted"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when order was last updated"
        }
      },
      "required": ["userId", "id", "items", "total", "status", "carrier", "trackingNumber"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Real-time stock levels and warehouse allocations for each drink flavor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Product ID matching flavor identifier",
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "description": "Flavor display name",
          "maxLength": 100
        },
        "stockCases": {
          "type": "number",
          "description": "Available stock in 12-pack cases"
        },
        "stockSingles": {
          "type": "number",
          "description": "Available individual cans stock"
        },
        "status": {
          "type": "string",
          "description": "Inventory health classification",
          "enum": ["In Stock", "Low Stock", "Out of Stock"]
        },
        "reorderThreshold": {
          "type": "number",
          "description": "Minimum case threshold before reorder notification triggers"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of inventory update"
        }
      },
      "required": ["id", "name", "stockCases", "stockSingles", "status"]
    },
    "FeedbackItem": {
      "title": "FeedbackItem",
      "description": "Customer taste reviews and sensory ratings submitted across flavors",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique feedback ID",
          "maxLength": 50
        },
        "authorName": {
          "type": "string",
          "description": "Customer reviewer name",
          "maxLength": 100
        },
        "authorEmail": {
          "type": "string",
          "format": "email",
          "description": "Customer email",
          "maxLength": 150
        },
        "rating": {
          "type": "number",
          "description": "Rating score from 1 to 5 stars"
        },
        "flavor": {
          "type": "string",
          "description": "Reviewed flavor",
          "maxLength": 60
        },
        "comment": {
          "type": "string",
          "description": "User feedback commentary",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of feedback submission"
        }
      },
      "required": ["id", "authorName", "rating", "flavor", "comment"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Subscribed email address for product updates and vitality discounts",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscribed email address",
          "maxLength": 150
        },
        "subscribedAt": {
          "type": "string",
          "description": "ISO timestamp of subscription"
        }
      },
      "required": ["email"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Direct inquiries from customer and wholesale partners",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Inquirer full name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "description": "Optional telephone or mobile number",
          "maxLength": 30
        },
        "message": {
          "type": "string",
          "description": "Inquiry or partnership message",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of inquiry submission"
        }
      },
      "required": ["name", "email", "message"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Store operational settings, announcement banners, and promo controls managed by Admin",
      "type": "object",
      "properties": {
        "storeStatus": {
          "type": "string",
          "description": "Store live operational status",
          "enum": ["open", "sale", "maintenance"]
        },
        "announcementBanner": {
          "type": "string",
          "description": "Global promotional announcement banner text",
          "maxLength": 300
        },
        "promoCode": {
          "type": "string",
          "description": "Active promotional coupon code",
          "maxLength": 30
        },
        "discountPercent": {
          "type": "number",
          "description": "Storewide discount percentage applied by promo"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last settings update"
        }
      },
      "required": ["storeStatus", "announcementBanner", "promoCode", "discountPercent"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document owned by the authenticated user"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "User order records with real-time tracking progress"
    },
    "/inventory/{productId}": {
      "schema": "InventoryItem",
      "description": "Real-time inventory levels for product line"
    },
    "/feedback/{feedbackId}": {
      "schema": "FeedbackItem",
      "description": "Customer taste ratings and product feedback"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Email list subscriptions with public create access"
    },
    "/contact_inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Contact form submissions"
    },
    "/settings/{settingId}": {
      "schema": "AppConfig",
      "description": "Operational app configuration and storewide announcements"
    }
  }
}
